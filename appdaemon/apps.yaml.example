# MeshCore AppDaemon Apps Configuration
# Add these entries to your /config/appdaemon/apps/apps.yaml

meshcore_hops:
  module: meshcore_hops
  class: MeshCoreHops

meshcore_paths:
  module: meshcore_paths
  class: MeshCorePathMap
  my_pubkey: "first 12 characters"

meshcore_cleanup:
  module: meshcore_cleanup
  class: MeshCoreCleanup

meshcore_greeter:
  module: meshcore_greeter
  class: MeshCoreGreeter
  my_name: "your repeater"
  hops_distant: 5

meshcore_heatmap_export:
  module: meshcore_heatmap_export
  class: MeshCoreHeatmapExport

meshcore_nodemap_export:
  module: meshcore_nodemap_export
  class: MeshCoreNodeMapExport

meshcore_directlinks_export:
  module: meshcore_directlinks_export
  class: MeshCoreDirectLinksExport

meshcore_map_config:
  module: meshcore_map_config
  class: MeshCoreMapConfig
  # CARTO basemaps now require an API key.
  # Get a free one (5M tiles/month) from https://carto.com/basemaps/apikey/
  carto_api_key: "your-carto-api-key"
